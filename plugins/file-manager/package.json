{
  "name": "bb-plugin-bb--file-manager",
  "version": "0.11.0",
  "description": "Browse, upload, download and organize files under your home folder from a bb sidebar panel.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/get-bb/bb#readme",
  "bugs": {
    "url": "https://github.com/get-bb/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/file-manager"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "contract.ts",
    "src",
    "components",
    "hooks",
    "lib",
    "README.md"
  ],
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "File Manager",
    "description": "Browse, upload, download, move, rename and extract files under your home folder in a full-page panel.",
    "branding": {
      "icon": "FolderOpen"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../scripts/build-official-plugins.mjs file-manager",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.3",
    "hono": "4.13.16",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@hugeicons/core-free-icons": "~4.3.4",
    "@hugeicons/react": "^1.1.10",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  }
}
